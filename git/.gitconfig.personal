    name = Henry Lee
    email = u88803494@gmail.com

[core]
    excludesfile = ~/.gitignore_global
    quotepath = false

[push]
    autoSetupRemote = true

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    unstage = reset HEAD --
    last = log -1 HEAD
    visual = log --graph --oneline --all
